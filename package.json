{
	"name": "quotum-api",
	"version": "0.9.1",
	"exports": {
		"./sdk": "./src/sdk/index.ts"
	},
	"bin": {
		"billing-catalog": "./scripts/billing-catalog.ts"
	},
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"migrate": "bun run src/migrate.ts",
		"migrate:status": "bun run src/migrate.ts status",
		"connections:rotate-secrets": "bun scripts/rotate-connection-secrets.ts",
		"platform:bootstrap": "bun run src/platform-bootstrap.ts",
		"catalog:provision": "bun run scripts/provision-catalog.ts",
		"catalog": "bun run scripts/billing-catalog.ts",
		"test": "bun test tests",
		"test:coverage": "bun test tests --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/check-coverage.ts coverage/lcov.info",
		"test:e2e": "bun run scripts/test-e2e.ts",
		"test:integration": "bun run scripts/test-integration.ts",
		"test:load": "bun run scripts/test-load.ts",
		"test:stripe-entrypoint": "bun run src/testing/test-stripe-entrypoint.ts",
		"check:boundaries": "bun run scripts/check-module-boundaries.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"quality": "bun run check:boundaries && bun run typecheck && bun run lint && bun run format:check",
		"quality:fix": "bun run lint:fix && bun run format",
		"test:merchant:integration": "bun run scripts/test-integration.ts integration/merchant",
		"openapi:generate": "bun scripts/openapi.ts",
		"openapi:check": "bun scripts/openapi.ts --check",
		"openapi:lint": "redocly lint contracts/v1/openapi.json"
	},
	"dependencies": {
		"@apple/app-store-server-library": "3.1.0",
		"@googleapis/androidpublisher": "38.0.0",
		"@hono/zod-openapi": "^1.6.3",
		"@sentry/bun": "^10.74.0",
		"better-auth": "1.7.3",
		"drizzle-orm": "^0.45.2",
		"google-auth-library": "11.0.2",
		"hono": "^4.13.7",
		"openapi3-ts": "^4.6.1",
		"stripe": "22.6.2",
		"zod": "^4.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@redocly/cli": "^2.51.2",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/bun": "latest",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"fast-check": "4.9.0",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"form-data": "4.0.6",
		"google-auth-library": "11.0.2"
	},
	"engines": {
		"bun": ">=1.4.0 <1.5.0"
	}
}
