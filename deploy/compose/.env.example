# Copy to .env next to compose.yaml, keep it private and append freshly generated secrets:
#   cp .env.example .env && chmod 600 .env
#   docker run --rm ghcr.io/quotumapp/quotum:<version> quotum init >> .env

# The image to run. Pin a release, ideally with its digest: 1.2.3@sha256:<digest>
QUOTUM_VERSION=
#QUOTUM_IMAGE=ghcr.io/quotumapp/quotum

# Password of the bundled Postgres. It is part of a connection URL: use letters and digits.
POSTGRES_PASSWORD=

# Host port for the API, published on 127.0.0.1 only.
#QUOTUM_PORT=3000

# compose.tls.yaml: the public hostname Caddy obtains a certificate for.
#QUOTUM_DOMAIN=billing.example.com
