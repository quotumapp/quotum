# Quotum Billing API - production environment example.
# Copy to .env (never commit it) or inject through your secret manager.

# --- Required -------------------------------------------------------------
POSTGRES_URI=postgres://quotum:CHANGE_ME@db.internal:5432/quotum

# Shared runtime pool and session limits. Optional overrides; current defaults shown.
# Restart the service after changes. Separate operator/migration clients keep their own limits.
#BILLING_POSTGRES_MAX_CONNECTIONS=20
#BILLING_POSTGRES_IDLE_TIMEOUT_SECONDS=60
#BILLING_POSTGRES_MAX_LIFETIME_SECONDS=0
# Driver default is 30 seconds; left unspecified unless explicitly configured.
#BILLING_POSTGRES_CONNECTION_TIMEOUT_SECONDS=30
# Zero disables an idle/lifetime limit or a PostgreSQL session timeout.
#BILLING_POSTGRES_STATEMENT_TIMEOUT_MS=30000
#BILLING_POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000
#BILLING_POSTGRES_TRANSACTION_TIMEOUT_MS=120000
BILLING_ENV=production
# Operator credential for catalog publication, replay, reconciliation and process metrics.
# At least 16 characters; keep it separate from per-project credentials.
BILLING_OPERATOR_API_KEY=CHANGE_ME_operator_key_min_16_chars
# Envelope key for encrypted provider and projection connections.
# 32 random bytes, base64 encoded (openssl rand -base64 32). Store it outside Postgres and its backups.
QUOTUM_SECRETS_KEY_ID=key-2026-09
QUOTUM_SECRETS_KEY_BASE64=CHANGE_ME_base64_32_bytes

# --- Merchant platform (optional; headless by default) -------------------------
# Unset or false runs headless: /v1 and workers only, and every setting in this block is ignored.
# Set true to enable the merchant console (/api); then every setting in this block is required.
#QUOTUM_CONSOLE_ENABLED=false
# Maximum logical projects per organization; each includes sandbox and production.
#QUOTUM_PROJECT_LIMIT=5
# Both URLs must be explicitly set in production; use your deployment's domains.
MERCHANT_ORIGIN=https://app.example.com
MERCHANT_PUBLIC_URL=https://example.com
# Quotum operator secret for sessions and token HMACs, not a registering merchant credential.
# At least 32 characters. Do not reuse other secrets.
QUOTUM_AUTH_SECRET=CHANGE_ME_at_least_32_random_characters
# Must match approved, published legal document versions.
MERCHANT_TERMS_VERSION=2026-09-01
MERCHANT_PRIVACY_VERSION=2026-09-01
# Set to false to close self-service registration.
MERCHANT_SIGNUP_ENABLED=true
# --- Quotum-owned transactional email sender (required outside tests) -------
# The operator configures this once; registering merchants supply only their recipient address.
# Explicitly select cloudflare or resend. Use a sender domain verified with that provider.
QUOTUM_EMAIL_PROVIDER=cloudflare
QUOTUM_EMAIL_FROM=no-reply@example.com
# Required only when QUOTUM_EMAIL_PROVIDER=cloudflare:
QUOTUM_EMAIL_CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
QUOTUM_EMAIL_CLOUDFLARE_API_TOKEN=CHANGE_ME
# For Resend, replace the provider line above with QUOTUM_EMAIL_PROVIDER=resend,
# remove the two Cloudflare settings, and supply:
#QUOTUM_EMAIL_RESEND_API_KEY=CHANGE_ME
# Optional Google sign-in; register https://app.example.com/api/auth/callback/google
#MERCHANT_GOOGLE_CLIENT_ID=
#MERCHANT_GOOGLE_CLIENT_SECRET=

# Optional remote MCP: deploy matching API schema and merchant UI/BFF before enabling.
QUOTUM_MCP_ENABLED=false
#QUOTUM_MCP_PUBLIC_ORIGIN=https://api.example.com

# --- HTTP -----------------------------------------------------------------
PORT=3000
# api_key (default) or gateway. gateway also requires BILLING_TRUST_GATEWAY_PROJECT_HEADER=true.
BILLING_AUTH_MODE=api_key
BILLING_TRUST_GATEWAY_PROJECT_HEADER=false
# Enable only behind infrastructure that strips client-supplied proxy headers.
BILLING_TRUST_PROXY_HEADERS=false
# Headless only: private networks projection receivers may use, and plain http to them.
# See docs/providers.md#private-receivers-headless-only before enabling.
#BILLING_PROJECTION_ALLOWED_NETWORKS=10.20.0.0/16
#BILLING_PROJECTION_ALLOW_INSECURE_HTTP=false

# --- Customer erasure (optional) -------------------------------------------
# A keyed digest lets an erasure tombstone keep an erased billing account id from being created
# again without storing the id. Generate the key with `openssl rand -base64 32`. Keep the previous
# pair configured for at least BILLING_ERASURE_TOMBSTONE_DAYS after a rotation.
# See docs/deployment.md#customer-erasure-keys.
#BILLING_ERASURE_KEY_ID=erasure-2026-10
#BILLING_ERASURE_KEY_BASE64=CHANGE_ME
#BILLING_ERASURE_PREVIOUS_KEY_ID=
#BILLING_ERASURE_PREVIOUS_KEY_BASE64=
#BILLING_ERASURE_TOMBSTONE_DAYS=30

# --- Workers (defaults shown) ---------------------------------------------
#BILLING_WORKER_ID=
BILLING_WORKER_POLL_INTERVAL_MS=5000
BILLING_PROJECTION_SYNC_MAX_ATTEMPTS=10
BILLING_EVENT_DELIVERY_MAX_ATTEMPTS=12
BILLING_EVENT_RETENTION_DAYS=30
BILLING_STORE_EVENT_REPLAY_MAX_ATTEMPTS=10
# Also paces Stripe App event processing when Apps OAuth is configured.
BILLING_STORE_EVENT_REPLAY_POLL_INTERVAL_MS=5000
BILLING_SUBSCRIPTION_RECONCILIATION_MAX_ATTEMPTS=10
BILLING_SUBSCRIPTION_RECONCILIATION_POLL_INTERVAL_MS=60000
BILLING_PROVIDER_RECONCILIATION_STALE_AFTER_MS=21600000
# Shared by metering maintenance, recurring billing, automatic top-ups and promotion maintenance.
BILLING_METERING_MAINTENANCE_POLL_INTERVAL_MS=60000
# Keeps monthly usage partitions a year ahead; false only if the table owner creates them.
BILLING_USAGE_PARTITION_UPKEEP=true
# Stripe connection validation verifies write permissions with requests that cannot succeed.
BILLING_STRIPE_WRITE_PERMISSION_PROBES=true

# Optional worker throughput overrides (current defaults shown). All must be positive integers.
# Unset per-worker intervals keep the shared polling fallbacks above. Retention windows,
# lease/heartbeat timing and retry policies stay unchanged. See docs/deployment.md#worker-tuning.
#BILLING_PROJECTION_SYNC_POLL_INTERVAL_MS=5000
#BILLING_PROJECTION_SYNC_BATCH_SIZE=25
#BILLING_PROJECTION_SYNC_CONCURRENCY=5
#BILLING_EVENT_DELIVERY_POLL_INTERVAL_MS=5000
#BILLING_EVENT_DELIVERY_BATCH_SIZE=25
#BILLING_EVENT_DELIVERY_CONCURRENCY=5
#BILLING_EVENT_DELIVERY_DISPATCH_BATCH_SIZE=100
#BILLING_EVENT_DELIVERY_RETENTION_BATCH_SIZE=1000
#BILLING_EVENT_DELIVERY_RETENTION_SWEEP_INTERVAL_MS=600000
#BILLING_STORE_EVENT_REPLAY_BATCH_SIZE=25
#BILLING_SUBSCRIPTION_RECONCILIATION_BATCH_SIZE=25
#BILLING_SUBSCRIPTION_RECONCILIATION_DEFAULT_PLAN_SCAN_SIZE=1000
#BILLING_SUBSCRIPTION_RECONCILIATION_DEFAULT_PLAN_MAX_BATCHES=10
#BILLING_METERING_MAINTENANCE_BATCH_SIZE=250
#BILLING_METERING_MAINTENANCE_RETENTION_BUDGET_MS=20000
#BILLING_RECURRING_BILLING_POLL_INTERVAL_MS=60000
#BILLING_RECURRING_BILLING_BATCH_SIZE=25
#BILLING_AUTO_TOPUP_POLL_INTERVAL_MS=60000
#BILLING_AUTO_TOPUP_BATCH_SIZE=25
#BILLING_PROMOTION_MAINTENANCE_POLL_INTERVAL_MS=60000
#BILLING_PROMOTION_MAINTENANCE_BATCH_SIZE=25
#BILLING_CUSTOMER_ERASURE_POLL_INTERVAL_MS=5000
#BILLING_CUSTOMER_ERASURE_BATCH_SIZE=500
#BILLING_CUSTOMER_ERASURE_BUDGET_MS=15000
#BILLING_CUSTOMER_ERASURE_MAX_CLAIMS=5
#BILLING_CUSTOMER_ERASURE_SWEEP_INTERVAL_MS=60000
#BILLING_PROVIDER_OPERATION_RECOVERY_POLL_INTERVAL_MS=10000
#BILLING_PROVIDER_OPERATION_RECOVERY_BATCH_SIZE=10
#BILLING_USAGE_PARTITION_UPKEEP_POLL_INTERVAL_MS=900000
#BILLING_STRIPE_APP_EVENTS_POLL_INTERVAL_MS=5000
#BILLING_STRIPE_APP_EVENTS_BATCH_SIZE=100
# Merchant-only sweep; these settings do not enable the merchant platform.
#QUOTUM_PLATFORM_RETENTION_POLL_INTERVAL_MS=900000
#QUOTUM_PLATFORM_RETENTION_BATCH_SIZE=1000
#QUOTUM_PLATFORM_RETENTION_MAX_BATCHES_PER_TABLE=25

# --- Rate limits (defaults shown) -----------------------------------------
BILLING_RATE_LIMIT_WINDOW_MS=60000
BILLING_VERIFY_RATE_LIMIT_PER_WINDOW=120
BILLING_WEBHOOK_RATE_LIMIT_PER_WINDOW=600
BILLING_METERING_RATE_LIMIT_PER_WINDOW=6000
#BILLING_ADMIN_RATE_LIMIT_PER_WINDOW=

# --- Observability (optional) ---------------------------------------------
# Local Pino diagnostics: trace, debug, info, warn, error, fatal, or silent.
BILLING_LOG_LEVEL=info
# Leave empty to disable Sentry.
SENTRY_DSN=
# Defaults to BILLING_ENV.
#SENTRY_ENVIRONMENT=
# Defaults to quotum-api@$BUILD_VERSION when set.
#SENTRY_RELEASE=
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_LOG_LEVEL=warn
SENTRY_CAPTURE_EXPECTED_ERRORS=false

# Remote billing proposals require browser approval; disabled by default.
QUOTUM_MCP_WRITES_ENABLED=false

# When enabling Stripe Apps OAuth with STRIPE_APP_CLIENT_ID, also set the Stripe App resource ID.
# This is the app_... ID, not the OAuth ca_... client ID or the app manifest package ID.
#STRIPE_APP_ID=app_...
