# Quotum Billing API - production environment example.
# Copy to .env (never commit it) or inject through your secret manager.

# --- Required -------------------------------------------------------------
POSTGRES_URI=postgres://quotum:CHANGE_ME@db.internal:5432/quotum
BILLING_ENV=production
# Operator credential for catalog publication, replay, reconciliation and process metrics.
# At least 16 characters; keep it separate from per-project credentials.
BILLING_OPERATOR_API_KEY=CHANGE_ME_operator_key_min_16_chars
# Envelope key for encrypted provider and projection connections.
# 32 random bytes, base64 encoded (openssl rand -base64 32). Store it outside Postgres and its backups.
QUOTUM_SECRETS_KEY_ID=key-2026-09
QUOTUM_SECRETS_KEY_BASE64=CHANGE_ME_base64_32_bytes

# --- Merchant platform (required) -----------------------------------------
# Both URLs must be explicitly set in production; use your deployment's domains.
MERCHANT_ORIGIN=https://app.example.com
MERCHANT_PUBLIC_URL=https://example.com
# Quotum operator secret for sessions and token HMACs, not a registering merchant credential.
# At least 32 characters. Do not reuse other secrets.
QUOTUM_AUTH_SECRET=CHANGE_ME_at_least_32_random_characters
# Must match approved, published legal document versions.
MERCHANT_TERMS_VERSION=2026-09-01
MERCHANT_PRIVACY_VERSION=2026-09-01
# Set to false to close self-service registration.
MERCHANT_SIGNUP_ENABLED=true
# --- Quotum-owned transactional email sender (required outside tests) -------
# The operator configures this once; registering merchants supply only their recipient address.
# Explicitly select cloudflare or resend. Use a sender domain verified with that provider.
QUOTUM_EMAIL_PROVIDER=cloudflare
QUOTUM_EMAIL_FROM=no-reply@example.com
# Required only when QUOTUM_EMAIL_PROVIDER=cloudflare:
QUOTUM_EMAIL_CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
QUOTUM_EMAIL_CLOUDFLARE_API_TOKEN=CHANGE_ME
# For Resend, replace the provider line above with QUOTUM_EMAIL_PROVIDER=resend,
# remove the two Cloudflare settings, and supply:
#QUOTUM_EMAIL_RESEND_API_KEY=CHANGE_ME
# Optional Google sign-in; register https://app.example.com/api/auth/callback/google
#MERCHANT_GOOGLE_CLIENT_ID=
#MERCHANT_GOOGLE_CLIENT_SECRET=

# --- HTTP -----------------------------------------------------------------
PORT=3000
# api_key (default) or gateway. gateway also requires BILLING_TRUST_GATEWAY_PROJECT_HEADER=true.
BILLING_AUTH_MODE=api_key
BILLING_TRUST_GATEWAY_PROJECT_HEADER=false
# Enable only behind infrastructure that strips client-supplied proxy headers.
BILLING_TRUST_PROXY_HEADERS=false

# --- Workers (defaults shown) ---------------------------------------------
#BILLING_WORKER_ID=
BILLING_WORKER_POLL_INTERVAL_MS=5000
BILLING_PROJECTION_SYNC_MAX_ATTEMPTS=10
BILLING_STORE_EVENT_REPLAY_MAX_ATTEMPTS=10
BILLING_STORE_EVENT_REPLAY_POLL_INTERVAL_MS=5000
BILLING_SUBSCRIPTION_RECONCILIATION_MAX_ATTEMPTS=10
BILLING_SUBSCRIPTION_RECONCILIATION_POLL_INTERVAL_MS=60000
BILLING_PROVIDER_RECONCILIATION_STALE_AFTER_MS=21600000
BILLING_METERING_MAINTENANCE_POLL_INTERVAL_MS=60000

# --- Rate limits (defaults shown) -----------------------------------------
BILLING_RATE_LIMIT_WINDOW_MS=60000
BILLING_VERIFY_RATE_LIMIT_PER_WINDOW=120
BILLING_WEBHOOK_RATE_LIMIT_PER_WINDOW=600
BILLING_METERING_RATE_LIMIT_PER_WINDOW=6000
#BILLING_ADMIN_RATE_LIMIT_PER_WINDOW=

# --- Observability (optional) ---------------------------------------------
# Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_LOG_LEVEL=warn
SENTRY_CAPTURE_EXPECTED_ERRORS=false
