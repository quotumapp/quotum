{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!contracts/v1"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"test": "all"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveNestedTestSuites": "error"
			},
			"style": {
				"noDoneCallback": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noDuplicateTestHooks": "error",
				"noExportsInTest": "error",
				"noFocusedTests": "error",
				"noSkippedTests": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
